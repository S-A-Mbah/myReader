        "#section-next"
      ],
      "label": "skip front matter, off camera"
    },
    {
      "type": "click",
      "selectors": [
        "#section-next"
      ],
      "label": "skip front matter, off camera"
    },
    {
      "type": "click",
      "selectors": [
